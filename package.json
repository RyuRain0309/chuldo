{
  "name": "chuldo",
  "version": "0.1.0",
  "description": "Electron + Python hybrid app for Windows UI Automation (read/control UI elements of apps like Zoom)",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "start": "npm run dev",
    "build:renderer": "vite build",
    "build:py": "cd automation && py -m PyInstaller --onefile --distpath dist --workpath build --specpath build scraper.py",
    "dist": "npm run build:renderer && npm run build:py && electron-builder"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "42.3.3",
    "electron-builder": "^25.0.5",
    "tailwindcss": "^4.3.3",
    "vite": "^6.0.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.chuldo.uiautomation",
    "productName": "Chuldo",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/main/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "automation/dist/scraper.exe",
        "to": "scraper.exe"
      }
    ],
    "win": {
      "target": "nsis"
    }
  }
}
